{
  "name": "sqlite-local",
  "version": "1.0.0",
  "description": "Local SQLite database MCP server for user data operations",
  "type": "stdio",
  "command": "python3",
  "args": ["-m", "mcp_server_sqlite", "--db-path", "/sandbox/user_data.db"],
  "env": {
    "PYTHONPATH": "/home/buntu1/school-ops-responder/mcp-servers/sqlite-local"
  },
  "capabilities": {
    "tools": {
      "execute": {
        "description": "Execute SQL queries on the local SQLite database",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "SQL query to execute" },
            "params": { "type": "array", "description": "Query parameters", "items": {} }
          },
          "required": ["query"]
        }
      },
      "query": {
        "description": "Execute SELECT query and return results",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sql": { "type": "string" },
            "params": { "type": "array", "items": {} }
          },
          "required": ["sql"]
        }
      },
      "list_tables": {
        "description": "List all tables in the database",
        "inputSchema": { "type": "object", "properties": {} }
      },
      "describe_table": {
        "description": "Get schema information for a table",
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": { "type": "string" }
          },
          "required": ["table"]
        }
      }
    },
    "resources": {
      "schema://tables": {
        "name": "Database Schema",
        "description": "Complete database schema as JSON"
      }
    }
  },
  "require_approval_for": ["execute", "query"]
}